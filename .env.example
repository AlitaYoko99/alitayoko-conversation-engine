AY_OLLAMA_BASE_URL=http://127.0.0.1:11434
AY_OLLAMA_MODEL=gpt-oss:20b
AY_API_KEY=change-me
AY_NUM_CTX=4096
AY_KEEP_ALIVE=30m
AY_MAX_REPAIR_ATTEMPTS=2
AY_REQUEST_TIMEOUT_SECONDS=180
AY_GROUND_SCHEMA_IN_PROMPT=false
AY_PREWARM_ON_START=true

# Optional Internet research via a self-hosted SearXNG instance.
# Research requests fail explicitly until SEARXNG_BASE_URL is configured.
AY_RESEARCH_PROVIDER=searxng
AY_SEARXNG_BASE_URL=
AY_RESEARCH_TIMEOUT_SECONDS=10
AY_RESEARCH_MAX_QUERIES=2
AY_RESEARCH_MAX_FOLLOWUP_QUERIES=1
AY_RESEARCH_MAX_SOURCES=5
AY_RESEARCH_SAFE_SEARCH=1

# Fetch the most relevant result pages after discovery. Only public HTTP(S)
# destinations are allowed; redirects are revalidated and response size is capped.
AY_RESEARCH_FETCH_ENABLED=true
AY_RESEARCH_FETCH_MAX_SOURCES=3
AY_RESEARCH_FETCH_TIMEOUT_SECONDS=8
AY_RESEARCH_FETCH_MAX_BYTES=5000000
AY_RESEARCH_FETCH_MAX_CHARS=2400
AY_RESEARCH_FETCH_MAX_REDIRECTS=3
AY_RESEARCH_FETCH_PDF_MAX_PAGES=40

# Final self-audit before JSON is returned. The factual audit may perform
# reverse research only when the request itself has features.research=true.
# The language/coherence audit never uses the web and may not change factual anchors.
AY_FINAL_AUDIT_ENABLED=true
AY_FINAL_AUDIT_FACT_ENABLED=true
AY_FINAL_AUDIT_LANGUAGE_ENABLED=true
AY_FINAL_AUDIT_REVERSE_RESEARCH_ENABLED=true
AY_FINAL_AUDIT_MAX_REVERSE_QUERIES=3
AY_FINAL_AUDIT_REVERSE_MAX_SOURCES=3
AY_FINAL_AUDIT_NUM_PREDICT=800
AY_FINAL_AUDIT_THINK=low

